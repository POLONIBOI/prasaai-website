---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import BentoGrid from '../components/BentoGrid.astro';
import StepCard from '../components/StepCard.astro';
import WhatsAppMockup from '../components/WhatsAppMockup.astro';
import DepartureBoard from '../components/DepartureBoard.astro';
import KpiCard from '../components/KpiCard.astro';
import ChatAdMockup from '../components/ChatAdMockup.astro';
import { site } from '../data/site';
import { features } from '../data/features';
import { channels } from '../data/channels';
import { testimonials } from '../data/testimonials';
import { roadmap } from '../data/roadmap';
import { ecosystem, ecosystemTagline } from '../data/ecosystem';
import { kpis } from '../data/dashboard';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "PRASA ai",
    "url": site.url,
    "logo": `${site.url}/favicon.svg`,
    "description": "AI-powered WhatsApp assistant for Cape Town Metrorail commuters",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+27-76-054-6767",
      "contactType": "customer service",
      "availableLanguage": ["English", "Afrikaans", "isiXhosa"]
    },
    "sameAs": ["https://wa.me/27760546767"]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PRASA ai",
    "url": site.url
  }
];
---

<BaseLayout
  title="PRASA ai — Your Cape Town Train Assistant on WhatsApp"
  description={site.description}
  canonical={`${site.url}/`}
  jsonLd={jsonLd}
>
  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container">
        <div class="hero-layout">
          <div class="hero-text">
            <span class="eyebrow hero-eyebrow"><span class="live-dot" aria-hidden="true"></span> Live · Cape Town Metrorail</span>
            <h1 data-animate data-delay="1">Will your train come? <em>Now you'll know.</em></h1>
            <p class="hero-sub" data-animate data-delay="2">PRASA ai is your Cape Town Metrorail assistant on WhatsApp — real-time schedules, delay alerts and crowd reports. Free, no app, in your language.</p>
            <div class="hero-actions" data-animate data-delay="3">
              <WhatsAppCTA variant="primary" />
              <a href="/dashboard" class="btn btn-ghost hero-secondary">See the live network &rarr;</a>
            </div>
            <ul class="hero-chips" data-animate data-delay="4">
              <li>Free</li>
              <li>No app download</li>
              <li>Any phone</li>
              <li>EN &middot; AF &middot; isiXhosa</li>
            </ul>
            <p class="hero-disclaimer" data-animate data-delay="5">Not an official PRASA service — <em>yet.</em></p>
          </div>
          <div class="hero-visual">
            <DepartureBoard />
          </div>
        </div>
      </div>
    </section>

    <!-- PROMISE BAND -->
    <section class="promise">
      <div class="container">
        <div class="promise-grid">
          <div class="promise-item" data-animate data-delay="1">
            <span class="promise-icon" aria-hidden="true">&#x23F1;&#xFE0F;</span>
            <div class="promise-text"><strong>Real-time status &amp; alerts</strong><span>Know before you leave home.</span></div>
          </div>
          <div class="promise-item" data-animate data-delay="2">
            <span class="promise-icon" aria-hidden="true">&#x1F465;</span>
            <div class="promise-text"><strong>Crowd-sourced accuracy</strong><span>Live reports from riders like you.</span></div>
          </div>
          <div class="promise-item" data-animate data-delay="3">
            <span class="promise-icon" aria-hidden="true">&#x1F4B0;</span>
            <div class="promise-text"><strong>Fares &amp; cheapest route</strong><span>Save ~R800/month vs taxis.</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- THE PROBLEM -->
    <div class="section-divider"></div>
    <section class="section section-problem">
      <div class="container">
        <div class="prose">
          <SectionHeading>You know the feeling.</SectionHeading>
          <p class="prose-quote" data-animate>It's 6:47am. You're standing on the platform. No train. No announcement. You check the time again. Is it 5 minutes late or cancelled? Nobody around you knows either.</p>

          <!-- Stat strip -->
          <div class="stat-strip" data-animate data-delay="1">
            <div class="stat-card">
              <span class="stat-number" data-count="150000" data-suffix="+">0</span>
              <span class="stat-label">Daily Riders</span>
            </div>
            <div class="stat-card">
              <span class="stat-number" data-count="800" data-prefix="R">0</span>
              <span class="stat-label">Saved vs Taxis / Month</span>
            </div>
            <div class="stat-card">
              <span class="stat-number" data-count="2">0</span>
              <span class="stat-label">Stations with Screens</span>
            </div>
          </div>

          <p data-animate data-delay="2">Cape Town Metrorail has been getting genuinely better. The new X'Trapolis Mega trains are safer and more reliable. The City approved a Rail Business Plan in December 2025. But the information layer hasn't kept pace — when disruptions hit, commuters still find out by standing on an empty platform. Meanwhile, commuters across the network have built informal WhatsApp groups to share sightings and delays in real time.</p>
          <p class="prose-punch" data-animate data-delay="3">The trains are getting better. The information should too.</p>
        </div>
      </div>
    </section>

    <!-- FEATURES (BENTO GRID) -->
    <div class="section-divider"></div>
    <section class="section section-features">
      <div class="container">
        <SectionHeading centered>What it does</SectionHeading>
        <BentoGrid>
          {features.map((f, i) => (
            <FeatureCard
              emoji={f.emoji}
              icon={f.icon}
              title={f.title}
              description={f.description}
              span={f.span}
              delay={i + 1}
            />
          ))}
        </BentoGrid>
        <p class="features-note" data-animate>Built independently using publicly available PRASA schedule data.</p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <div class="section-divider"></div>
    <section class="section section-howitworks">
      <div class="container">
        <SectionHeading centered>How it works</SectionHeading>
        <div class="steps-grid">
          <StepCard num={1} emoji="\u{1F4AC}" title="Message us on WhatsApp" description="Save +27 76 054 6767 or tap the button below." delay={1} />
          <div class="step-connector" aria-hidden="true">
            <svg class="step-connector-svg" viewBox="0 0 40 4" xmlns="http://www.w3.org/2000/svg">
              <line x1="0" y1="2" x2="40" y2="2" stroke="var(--amber-border)" stroke-width="2" stroke-dasharray="4 4"/>
              <circle class="step-connector-dot" r="3" fill="var(--amber)" cy="2">
                <animate attributeName="cx" values="0;40;0" dur="3s" repeatCount="indefinite" calcMode="spline" keySplines="0.42 0 0.58 1;0.42 0 0.58 1"/>
              </circle>
            </svg>
          </div>
          <StepCard num={2} emoji="\u{1F5E3}\uFE0F" title="Ask anything" description='"next train Retreat to Cape Town" or just "?" for your saved route.' delay={2} />
          <div class="step-connector" aria-hidden="true">
            <svg class="step-connector-svg" viewBox="0 0 40 4" xmlns="http://www.w3.org/2000/svg">
              <line x1="0" y1="2" x2="40" y2="2" stroke="var(--amber-border)" stroke-width="2" stroke-dasharray="4 4"/>
              <circle class="step-connector-dot" r="3" fill="var(--amber)" cy="2">
                <animate attributeName="cx" values="0;40;0" dur="3s" repeatCount="indefinite" calcMode="spline" keySplines="0.42 0 0.58 1;0.42 0 0.58 1"/>
              </circle>
            </svg>
          </div>
          <StepCard num={3} emoji="\u26A1" title="Get answers in seconds" description="Timetables, fares, maps, alerts — all in your chat." delay={3} />
        </div>

        <WhatsAppMockup />

        <div class="cta-center">
          <WhatsAppCTA variant="secondary" text="Try it now on WhatsApp" />
        </div>
      </div>
    </section>

    <!-- BUILT BY A COMMUTER -->
    <div class="section-divider"></div>
    <section class="section section-story story-section">
      <div class="container">
        <div class="prose">
          <SectionHeading>Built by a commuter. For commuters.</SectionHeading>
          <p data-animate>I ride the train every day. Every morning I'd stand on the platform wondering if my train was coming, delayed, or cancelled — scrolling Twitter for updates that came 30 minutes too late, asking in WhatsApp groups where someone three stations away might know something. Most mornings, I'd just guess.</p>
          <p data-animate data-delay="1">So I built what I wished existed. A WhatsApp bot that knows the full Metrorail timetable, checks for disruptions in real-time, and understands when you type "muizi to town." PRASA ai is not affiliated with PRASA — not yet. We're an independent project built by commuters, for commuters, with one goal: to prove that better passenger communication isn't just possible, it's overdue.</p>
        </div>
      </div>
    </section>

    <!-- WHATSAPP CHANNELS -->
    <div class="section-divider"></div>
    <section class="section section-channels">
      <div class="container">
        <SectionHeading centered>Follow your line</SectionHeading>
        <p class="channels-subtitle" data-animate>Get real-time updates from PRASA's official WhatsApp channels.</p>
        <div class="channels-grid">
          {channels.map((ch, i) => (
            <a
              href={ch.url}
              target="_blank"
              rel="noopener noreferrer"
              class="channel-card"
              style={`--channel-color: var(${ch.colorVar})`}
              data-animate
              data-delay={i + 1}
            >
              <span class="channel-name">{ch.name}</span>
              <span class="channel-follow">
                <svg class="channel-wa-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Follow
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <!-- PLACEHOLDER: Replace with real commuter testimonials when available -->
    <div class="section-divider"></div>
    <section class="section section-testimonials">
      <div class="container">
        <SectionHeading centered>What commuters say</SectionHeading>
        <div class="testimonials-grid">
          {testimonials.map((t, i) => (
            <div class="testimonial-card" data-animate data-delay={(i % 5) + 1}>
              <svg class="testimonial-quote-icon" width="24" height="24" viewBox="0 0 24 24" fill="var(--amber-subtle)" aria-hidden="true">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11h4v10H0z"/>
              </svg>
              <p class="testimonial-text">{t.quote}</p>
              <div class="testimonial-author">
                <span class="testimonial-name">{t.name}</span>
                <span class="testimonial-line">{t.line}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PUBLIC DASHBOARD TEASER -->
    <div class="section-divider"></div>
    <section class="section section-dataproof">
      <div class="container">
        <div class="teaser-head">
          <span class="eyebrow">For PRASA &amp; the City</span>
          <SectionHeading>The data behind the chat.</SectionHeading>
          <p class="teaser-sub" data-animate>Every question is a signal. PRASA ai sees the network the way passengers <em>experience</em> it — demand, sentiment, and the exact stations where riders feel left in the dark. A live, passenger-sourced view no signalling system can give you.</p>
        </div>
        <div class="kpi-grid">
          {kpis.map((k, i) => <KpiCard kpi={k} delay={i + 1} />)}
        </div>
        <div class="cta-center cta-spaced">
          <a href="/dashboard" class="btn btn-outline">Open the public dashboard &rarr;</a>
        </div>
      </div>
    </section>

    <!-- ADVERTISE TEASER -->
    <div class="section-divider"></div>
    <section class="section section-adteaser">
      <div class="container">
        <div class="adteaser-layout">
          <div class="adteaser-text">
            <span class="eyebrow">For advertisers</span>
            <SectionHeading>Reach commuters in the moment.</SectionHeading>
            <p data-animate>Thousands of Cape Town commuters open PRASA ai the instant they plan a trip — a captive, daily, location- and time-specific audience inside WhatsApp. A single, labelled sponsored line rides along with their schedule reply. Around 100% viewable. Measurable. Brand-safe.</p>
            <ul class="adteaser-stats" data-animate data-delay="1">
              <li><strong class="mono">~98%</strong><span>open rate</span></li>
              <li><strong class="mono">~100%</strong><span>viewability</span></li>
              <li><strong class="mono">AM·PM</strong><span>peak targeting</span></li>
            </ul>
            <a href="/advertise" class="btn btn-outline">See ad formats &rarr;</a>
          </div>
          <div class="adteaser-demo">
            <ChatAdMockup
              bot={['🚆 Northern Line — Bellville → Cape Town', '✅ On time · Next 07:42 · Platform 2']}
              adTitle="☕ Vida e Caffè @ Cape Town Station"
              adBody="R10 off your morning coffee — show this chat."
              adCta="Get offer"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- SYSTEM SOL ECOSYSTEM -->
    <div class="section-divider"></div>
    <section class="section section-ecosystem">
      <div class="container">
        <div class="teaser-head centered-head">
          <span class="eyebrow">What System Sol is building next</span>
          <SectionHeading centered>One assistant today. A platform tomorrow.</SectionHeading>
          <p class="teaser-sub teaser-sub-centered" data-animate>{ecosystemTagline}</p>
        </div>
        <div class="eco-grid">
          {ecosystem.map((p, i) => (
            <div class:list={['eco-card', p.status === 'Live' && 'eco-live']} style={`--eco: var(${p.colorVar})`} data-animate data-delay={i + 1}>
              <div class="eco-top">
                <span class="eco-mark">{p.initial}</span>
                <span class:list={['eco-status', `eco-status-${p.status === 'Live' ? 'live' : p.status === 'In build' ? 'build' : 'soon'}`]}>{p.status}</span>
              </div>
              <h3>{p.name}</h3>
              <p class="eco-tagline">{p.tagline}</p>
              <p class="eco-desc">{p.description}</p>
            </div>
          ))}
        </div>
        <p class="eco-disclaimer" data-animate>GABS ai, YourGov and Fleet ai are in development by System Sol. PRASA ai is independent and not affiliated with PRASA or Golden Arrow.</p>
      </div>
    </section>

    <!-- ROADMAP -->
    <div class="section-divider"></div>
    <section class="section section-roadmap">
      <div class="container">
        <SectionHeading centered>What's next</SectionHeading>
        <p class="roadmap-subtitle" data-animate>PRASA ai is actively growing. Here's what we've shipped and what's coming.</p>
        <div class="roadmap-grid">
          {roadmap.map((item, i) => (
            <div class={`roadmap-card roadmap-${item.status}`} data-animate data-delay={(i % 5) + 1}>
              <span class="roadmap-badge">{item.status === 'shipped' ? 'Shipped' : item.status === 'building' ? 'Building' : 'Planned'}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- OPEN INVITATION -->
    <div class="section-divider"></div>
    <section class="section">
      <div class="container">
        <div class="invitation-card" data-animate="scale-in">
          <SectionHeading centered>To PRASA: Let's talk.</SectionHeading>
          <p>We built PRASA ai because we believe South Africa's commuters deserve world-class passenger information. We've done the hard work — real-time timetables, AI-powered assistance, crowd-sourced reporting, multilingual support. All on WhatsApp, where your passengers already are.</p>
          <p>This could be so much bigger as an official service. If anyone at PRASA, Metrorail, or the City of Cape Town wants to explore what that looks like — we're ready.</p>
          <div class="invitation-actions">
            <a href="/partner" class="btn-outline">Learn more</a>
            <a href={`mailto:${site.email}`} class="btn-outline-secondary">Get in touch</a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ============ HERO ============ */
  .hero {
    position: relative;
    padding: 92px 0 48px;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: -20% 0 auto 0;
    height: 600px;
    background: var(--gradient-hero);
    pointer-events: none;
  }

  .hero-layout {
    display: flex;
    flex-direction: column;
    gap: 36px;
    position: relative;
  }

  .hero-eyebrow {
    margin-bottom: 18px;
    color: var(--text-secondary);
  }
  .hero-eyebrow::before { display: none; }

  .hero h1 {
    font-size: var(--fs-display);
    font-weight: 800;
    margin-bottom: 18px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--amber);
    background: linear-gradient(90deg, var(--amber) 0%, #FFE580 45%, var(--amber) 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: text-shimmer 3s ease-in-out infinite;
  }

  @keyframes text-shimmer {
    0% { background-position: 200% 50%; }
    100% { background-position: -200% 50%; }
  }

  .hero-sub {
    font-size: var(--fs-lead);
    color: var(--text-secondary);
    max-width: 540px;
    margin-bottom: 28px;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }

  .hero-secondary { padding: 13px 22px; }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    list-style: none;
    margin-bottom: 16px;
  }

  .hero-chips li {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }

  .hero-disclaimer {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-style: italic;
  }
  .hero-disclaimer em { color: var(--amber); font-style: italic; }

  .hero-visual { width: 100%; }

  @media (min-width: 920px) {
    .hero { padding: 132px 0 80px; }
    .hero-layout {
      flex-direction: row;
      align-items: center;
      gap: 56px;
    }
    .hero-text { flex: 1 1 0; min-width: 0; }
    .hero-visual { flex: 0 0 420px; max-width: 420px; }
  }

  /* ============ PROMISE BAND ============ */
  .promise { padding: 8px 0; }
  .promise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .promise-item {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 16px 18px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .promise-item:hover { border-color: var(--amber-border); transform: translateY(-2px); }
  .promise-icon { font-size: 1.4rem; flex-shrink: 0; }
  .promise-text { display: flex; flex-direction: column; }
  .promise-text strong { font-family: var(--font-display); font-size: 0.95rem; color: var(--text-primary); }
  .promise-text span { font-size: 0.82rem; color: var(--text-secondary); }

  @media (min-width: 720px) {
    .promise-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* SECTIONS */
  .section {
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  /* Section background gradients */
  .section-problem::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 0% 0%, rgba(255, 68, 68, 0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  .section-features::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(94, 155, 255, 0.03) 0%, transparent 60%);
    pointer-events: none;
  }

  .section-howitworks::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 100% 100%, rgba(56, 181, 74, 0.03) 0%, transparent 60%);
    pointer-events: none;
  }

  .section-story::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(255, 154, 48, 0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
  }

  .prose p {
    margin-bottom: 24px;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .prose-quote {
    font-size: 1.1rem;
    color: var(--text-primary) !important;
    font-style: italic;
    border-left: 3px solid var(--amber);
    padding-left: 20px;
  }

  .prose-punch {
    color: var(--amber) !important;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 1.15rem !important;
    font-style: normal;
  }

  /* STAT STRIP */
  .stat-strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 32px 0;
  }

  .stat-card {
